{
  "name": "math-pocket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5186 --strictPort",
    "build": "vite build && node scripts/portable.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4186 --strictPort",
    "android:sync": "pnpm build && cap sync android",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src scripts tests *.js *.json *.html *.md",
    "format:check": "prettier --check src scripts tests *.js *.json *.html *.md"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/android": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "dexie": "4.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@vitejs/plugin-react": "5.2.0",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "fake-indexeddb": "6.2.6",
    "prettier": "3.9.10"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
